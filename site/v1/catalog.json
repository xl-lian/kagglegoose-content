    {
      "id": "w-10441",
      "competitionID": "optiver-realized-volatility-prediction",
      "title": "借相似股票预测波动率",
      "author": "nyanp",
      "summary": "单只股票的一段历史太短。冠军为股票和时段寻找相似样本，再把邻居的统计特征提供给模型。",
      "takeaway": "在时间切分固定的条件下，为一个基础特征加上邻居均值，比较各折误差。",
      "tags": [
        "近邻聚合",
        "时间验证"
      ],
      "published": "2022-01-11T12:54:29.477Z",
      "steps": [
        {
          "title": "验证设计",
          "body": "作者先重建匿名时段的先后顺序，再使用 4 折时间验证，每折留出约 10% 的数据做验证。",
          "reference": "Reverse engineering of time-id order",
          "source": 0
        },
        {
          "title": "特征工程",
          "body": "从已有统计量构造距离，找到相似股票或相似时段，再聚合邻居特征。这让模型同时看到局部和跨样本的信息。",
          "reference": "Feature engineering",
          "source": 0
        },
        {
          "title": "迁移与复现",
          "body": "原文讨论了竞赛与实际预测的时间信息差异。复现时在每个验证切点限制可访问的邻居，避免提前看到未来。",
          "reference": "Feature processing",
          "source": 0
        }
      ],
      "sources": [
        {
          "title": "冠军方案原文",
